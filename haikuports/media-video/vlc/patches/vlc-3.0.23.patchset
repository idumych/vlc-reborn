 .../gui/qt/components/interface_widgets.cpp   |  12 +-
 .../gui/qt/components/interface_widgets.hpp   |   3 +-
 modules/gui/qt/dialogs/plugins.cpp            |   1 +
 modules/gui/qt/main_interface.cpp             |  12 +-
 modules/gui/qt/qt.cpp                         |   2 +
 modules/gui/qt/util/timetooltip.cpp           |   9 +
 modules/video_output/Makefile.am              |  10 +
