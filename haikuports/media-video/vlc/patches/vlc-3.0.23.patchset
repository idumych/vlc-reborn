 #include <errno.h>
 # ifndef HAVE_STRUCT_IF_NAMEINDEX
@@ -438,6 +443,7 @@ struct if_nameindex
 # define if_nameindex()         (errno = ENOBUFS, NULL)
 # define if_freenameindex(list) (void)0
 #endif
+#endif
 
 #ifndef HAVE_STRUCT_TIMESPEC
 struct timespec {
