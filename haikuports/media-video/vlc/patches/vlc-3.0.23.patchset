-        snooze(10000);
+    if (sys->embed != NULL) {
+        /* Give the interface its view back */
+        BLooper *looper = sys->view->Looper();
+        if (looper != NULL && looper->Lock()) {
+            sys->view->RemoveSelf();
+            looper->Unlock();
+        }
+        delete sys->view;
+        vout_display_DeleteWindow(vd, sys->embed);
+    } else {
+        /* Wait until the window is gone: with the Haiku API on Linux,
+         * Quit() from another thread (and wait_for_thread()) can return
+         * before it is */
+        BMessenger messenger(sys->window);
+        if (sys->window->Lock())
+            sys->window->Quit();
+        for (int i = 0; i < 200 && messenger.IsValid(); i++)
+            snooze(10000);
+    }
 
 #ifdef HAIKU_VOUT_GL
     if (sys->gl != NULL)
-- 
2.56.0


From b533f8e378f1e6c86229994bcd9bda1eee39f76e Mon Sep 17 00:00:00 2001
From: idumych <idumych@gmail.com>
Date: Sun, 25 Oct 2026 23:15:42 -0700
Subject: [PATCH 11/11] Packaging and comments: Haiku and Linux

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 configure.ac                            | 6 +++---
 include/vlc_vout_display.h              | 2 +-
 modules/gui/haiku/MessagesWindow.cpp    | 4 ++--
 modules/gui/haiku/PlayListWindow.cpp    | 4 ++--
 modules/gui/haiku/PreferencesWindow.cpp | 4 ++--
 5 files changed, 10 insertions(+), 10 deletions(-)

diff --git a/configure.ac b/configure.ac
index 948650a..144b95c 100644
--- a/configure.ac
+++ b/configure.ac
@@ -409,7 +409,7 @@ AM_CONDITIONAL(HAVE_HAIKU,     test "${SYS}" = "haiku")
 
 dnl
 dnl  Haiku API: the native interface and video output, on Haiku and on
-dnl  systems that provide the Haiku API (VitruvianOS, Cosmoe)
+dnl  systems that provide the Haiku API (Cosmoe/Hokku)
 dnl
 AC_ARG_ENABLE([haiku-api],
   AS_HELP_STRING([--enable-haiku-api],
@@ -423,7 +423,7 @@ AS_IF([test "${enable_haiku_api}" = "yes"], [
     AS_IF([test "${SYS}" = "haiku"], [
       HAIKU_API_LIBS="-lbe"
     ], [
-      AC_MSG_ERROR([Set HAIKU_API_CFLAGS and HAIKU_API_LIBS to use the Haiku API (VitruvianOS SDK or Cosmoe).])
+      AC_MSG_ERROR([Set HAIKU_API_CFLAGS and HAIKU_API_LIBS to use the Haiku API (Cosmoe/Hokku).])
     ])
   ])
   AC_DEFINE([VLC_HAIKU_API], 1, [Define to 1 to build the Haiku API interface and video output.])
@@ -3203,7 +3203,7 @@ PKG_CHECK_MODULES([GL], [gl], [
 AM_CONDITIONAL([HAVE_GL], [test "${have_gl}" = "yes"])
 
 dnl OpenGL output in a BGLView (Haiku API): libGL on Haiku; elsewhere the
-dnl library with BGLView must be named (VitruvianOS: -lopengl)
+dnl library with BGLView must be named (for example -lopengl)
 AC_ARG_VAR([HAIKU_GL_LIBS], [linker flags for BGLView (default: -lGL on Haiku)])
 AS_IF([test "${SYS}" = "haiku" && test -z "${HAIKU_GL_LIBS}"], [HAIKU_GL_LIBS="-lGL"])
 AM_CONDITIONAL([HAVE_HAIKU_GL], [test "${enable_haiku_api}" = "yes" && test "${have_gl}" = "yes" && test -n "${HAIKU_GL_LIBS}"])
diff --git a/include/vlc_vout_display.h b/include/vlc_vout_display.h
index 7a668c8..67c80dd 100644
--- a/include/vlc_vout_display.h
+++ b/include/vlc_vout_display.h
@@ -24,7 +24,7 @@
 #ifndef VLC_VOUT_DISPLAY_H
 #define VLC_VOUT_DISPLAY_H 1
 
-/* Haiku and the Haiku API (VitruvianOS, Cosmoe) use the display's own
+/* Haiku and the Haiku API (Cosmoe) use the display's own
  * fullscreen and window-state controls; on Haiku this is always on, so
  * that plugins built outside VLC see the same structures */
 #if defined(__HAIKU__) && !defined(VLC_HAIKU_API)
diff --git a/modules/gui/haiku/MessagesWindow.cpp b/modules/gui/haiku/MessagesWindow.cpp
index 9dbd1d9..f006c72 100644
--- a/modules/gui/haiku/MessagesWindow.cpp
+++ b/modules/gui/haiku/MessagesWindow.cpp
@@ -211,8 +211,8 @@ void MessagesWindow::ReallyQuit()
     if( fSubscribed )
         vlc_LogSet( p_intf->obj.libvlc, NULL, NULL );
 
-    /* Wait until the window is gone: on VitruvianOS, Quit() from another
-     * thread (and wait_for_thread()) can return before it is */
+    /* Wait until the window is gone: with the Haiku API on Linux, Quit()
+     * from another thread (and wait_for_thread()) can return before it is */
     BMessenger messenger( this );
     Lock();
     Hide();
diff --git a/modules/gui/haiku/PlayListWindow.cpp b/modules/gui/haiku/PlayListWindow.cpp
index 94f6b39..d9fe024 100644
--- a/modules/gui/haiku/PlayListWindow.cpp
+++ b/modules/gui/haiku/PlayListWindow.cpp
@@ -212,8 +212,8 @@ PlayListWindow::MessageReceived( BMessage * p_message )
 void
 PlayListWindow::ReallyQuit()
 {
-    /* Wait until the window is gone: on VitruvianOS, Quit() from another
-     * thread (and wait_for_thread()) can return before it is */
+    /* Wait until the window is gone: with the Haiku API on Linux, Quit()
+     * from another thread (and wait_for_thread()) can return before it is */
     BMessenger messenger( this );
     Lock();
     Hide();
diff --git a/modules/gui/haiku/PreferencesWindow.cpp b/modules/gui/haiku/PreferencesWindow.cpp
index 26296f7..3c347ba 100644
--- a/modules/gui/haiku/PreferencesWindow.cpp
+++ b/modules/gui/haiku/PreferencesWindow.cpp
@@ -369,8 +369,8 @@ void PreferencesWindow::Apply( bool doIt )
 void
 PreferencesWindow::ReallyQuit()
 {
-    /* Wait until the window is gone: on VitruvianOS, Quit() from another
-     * thread (and wait_for_thread()) can return before it is */
+    /* Wait until the window is gone: with the Haiku API on Linux, Quit()
+     * from another thread (and wait_for_thread()) can return before it is */
     BMessenger messenger( this );
     Lock();
     Hide();
