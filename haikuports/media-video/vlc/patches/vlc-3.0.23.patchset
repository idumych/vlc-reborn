From fb99bbc4558482ed9729b4e5010118fd3ec2c5bf Mon Sep 17 00:00:00 2001
From: idumych <idumych@gmail.com>
Date: Sat, 24 Oct 2026 17:18:44 -0700
Subject: [PATCH 04/11] Haiku API on Linux: --enable-haiku-api for VitruvianOS
 and Cosmoe

The interface, the BBitmap video output and the BApplication helper
now build wherever the Haiku API is available, not only on Haiku:

* configure: --enable-haiku-api (on by default on Haiku) with
  HAIKU_API_CFLAGS and HAIKU_API_LIBS, defining VLC_HAIKU_API.
* The core's display fullscreen/window-state path is selected by
  VLC_HAIKU_API instead of __HAIKU__; vlc_vout_display.h still turns it
  on by itself on Haiku so outside plugins see the same structures.
* libvlccore gets haiku/application.cpp with the Haiku API, and stubs
  for vlc_haiku_app_* otherwise.
* The disc menu is Haiku only (it uses Haiku device ioctls).
* video_output/haiku: outside Haiku, frames are drawn by Draw() after
  an Invalidate(); Cosmoe doesn't show drawing done from other threads.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 configure.ac                          | 23 ++++++++++++++
 include/vlc_vout_display.h            | 15 ++++++---
 include/vlc_vout_wrapper.h            |  2 +-
 modules/gui/Makefile.am               |  5 +--
 modules/gui/haiku/InterfaceWindow.cpp |  6 ++++
 modules/video_output/Makefile.am      |  5 +--
 modules/video_output/haiku.cpp        |  8 +++++
 src/Makefile.am                       | 11 +++++--
 src/misc/haiku_stub.c                 | 45 +++++++++++++++++++++++++++
 src/video_output/display.c            | 18 +++++------
 src/video_output/video_output.c       | 10 +++---
 11 files changed, 123 insertions(+), 25 deletions(-)
 create mode 100644 src/misc/haiku_stub.c

diff --git a/configure.ac b/configure.ac
index 459b63a..8124cc3 100644
--- a/configure.ac
+++ b/configure.ac
@@ -407,6 +407,29 @@ AM_CONDITIONAL(HAVE_LINUX,   test "${SYS}" = "linux")
 AM_CONDITIONAL(HAVE_OS2,     test "${SYS}" = "os2")
 AM_CONDITIONAL(HAVE_HAIKU,     test "${SYS}" = "haiku")
 
+dnl
+dnl  Haiku API: the native interface and video output, on Haiku and on
+dnl  systems that provide the Haiku API (VitruvianOS, Cosmoe)
+dnl
+AC_ARG_ENABLE([haiku-api],
+  AS_HELP_STRING([--enable-haiku-api],
+    [Haiku interface and BBitmap video output (default enabled on Haiku)]),, [
+  AS_IF([test "${SYS}" = "haiku"], [enable_haiku_api="yes"], [enable_haiku_api="no"])
+])
+AC_ARG_VAR([HAIKU_API_CFLAGS], [C++ flags for the Haiku API headers])
+AC_ARG_VAR([HAIKU_API_LIBS], [linker flags for the Haiku API libraries])
+AS_IF([test "${enable_haiku_api}" = "yes"], [
+  AS_IF([test -z "${HAIKU_API_LIBS}"], [
+    AS_IF([test "${SYS}" = "haiku"], [
+      HAIKU_API_LIBS="-lbe"
+    ], [
+      AC_MSG_ERROR([Set HAIKU_API_CFLAGS and HAIKU_API_LIBS to use the Haiku API (VitruvianOS SDK or Cosmoe).])
+    ])
+  ])
+  AC_DEFINE([VLC_HAIKU_API], 1, [Define to 1 to build the Haiku API interface and video output.])
+])
+AM_CONDITIONAL([HAVE_HAIKU_API], [test "${enable_haiku_api}" = "yes"])
+
 AM_CONDITIONAL(HAVE_DARWIN,  test "${SYS}" = "darwin")
 AM_CONDITIONAL(HAVE_IOS,     test "${HAVE_IOS}" = "1")
 AM_CONDITIONAL(HAVE_OSX,     test "${HAVE_OSX}" = "1")
