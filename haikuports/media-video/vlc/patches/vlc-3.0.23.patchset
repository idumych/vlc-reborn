diff --git a/include/vlc_haiku.h b/include/vlc_haiku.h
new file mode 100644
index 0000000..3456c36
--- /dev/null
+++ b/include/vlc_haiku.h
@@ -0,0 +1,61 @@
+/*****************************************************************************
+ * vlc_haiku.h: Haiku application helpers
+ *****************************************************************************
+ * Copyright (C) 2026 VLC authors and VideoLAN
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU Lesser General Public License as published by
+ * the Free Software Foundation; either version 2.1 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+ * GNU Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public License
+ * along with this program; if not, write to the Free Software Foundation,
+ * Inc., 51 Franklin Street, Fifth Floor, Boston MA 02110-1301, USA.
+ *****************************************************************************/
+
+#ifndef VLC_HAIKU_H
+#define VLC_HAIKU_H 1
+
+/**
+ * \file
+ * Every window on Haiku needs a running BApplication (be_app). LibVLC can
+ * be used inside a program that already has one; otherwise libvlccore
+ * starts its own in a dedicated thread. Interface, video and audio output
+ * plugins hold it for as long as they need it.
+ */
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * Makes sure be_app exists and is running.
+ * \return VLC_SUCCESS or an error code
+ */
+VLC_API int vlc_haiku_app_Hold(vlc_object_t *obj);
+#define vlc_haiku_app_Hold(o) vlc_haiku_app_Hold(VLC_OBJECT(o))
+
+/**
+ * Releases a reference taken with vlc_haiku_app_Hold(). The application
+ * started by libvlccore quits when the last reference goes away.
+ */
+VLC_API void vlc_haiku_app_Release(void);
+
+/**
+ * Sets the BLooper (passed as void *) that receives the messages sent to
+ * the application by the system: B_REFS_RECEIVED (files opened from
+ * Tracker or dropped on the Deskbar), B_ABOUT_REQUESTED and
+ * B_QUIT_REQUESTED. Pass NULL to unset it.
+ */
+VLC_API void vlc_haiku_app_SetTarget(void *looper);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/modules/access/dvdnav.c b/modules/access/dvdnav.c
index 7bb4738..0c1d5b4 100644
--- a/modules/access/dvdnav.c
+++ b/modules/access/dvdnav.c
@@ -1695,6 +1695,36 @@ static int ProbeDVD( const char *psz_name )
          goto bailout;
     if( !S_ISREG( stat_info.st_mode ) )
     {
+#ifdef __HAIKU__
+        /* libdvdread crashes while scanning ordinary folders on Haiku: only
+         * let it look at folders that are, or contain, VIDEO_TS */
+        if( S_ISDIR( stat_info.st_mode ) )
+        {
+            const char *psz_base = strrchr( psz_name, '/' );
+            psz_base = psz_base ? psz_base + 1 : psz_name;
+            if( !strcasecmp( psz_base, "VIDEO_TS" ) )
+                ret = VLC_SUCCESS;
+            else
+            {
+                char *psz_ts;
+                struct stat ts_info;
+                if( asprintf( &psz_ts, "%s/VIDEO_TS", psz_name ) != -1 )
+                {
+                    if( vlc_stat( psz_ts, &ts_info ) == 0 )
+                        ret = VLC_SUCCESS;
+                    else
+                    {
+                        psz_ts[strlen( psz_ts ) - 8] = '\0';
+                        strcat( psz_ts, "video_ts" );
+                        if( vlc_stat( psz_ts, &ts_info ) == 0 )
+                            ret = VLC_SUCCESS;
+                    }
+                    free( psz_ts );
+                }
+            }
+            goto bailout;
+        }
+#endif
         if( S_ISDIR( stat_info.st_mode ) || S_ISBLK( stat_info.st_mode ) )
             ret = VLC_SUCCESS; /* Let dvdnav_open() do the probing */
         goto bailout;
diff --git a/modules/audio_output/haiku.cpp b/modules/audio_output/haiku.cpp
index 025c285..d1d3186 100644
--- a/modules/audio_output/haiku.cpp
+++ b/modules/audio_output/haiku.cpp
@@ -26,6 +26,7 @@
 #include <vlc_common.h>
 #include <vlc_plugin.h>
 #include <vlc_aout.h>
+#include <vlc_haiku.h>
 
 #include <float.h>
 #include <sys/param.h>
@@ -67,6 +68,7 @@ static void Flush    ( audio_output_t *, bool );
 static int  TimeGet  ( audio_output_t *, mtime_t *restrict );
 static int  VolumeSet(audio_output_t* aout, float volume);
 static int  MuteSet  (audio_output_t* aout, bool mute);
+static void ApplyVolume(aout_sys_t* sys);
 
 static void PlayBuffer(void* cookie, void* buffer, size_t size, const media_raw_audio_format &format);
 
@@ -124,7 +126,7 @@ static int Start ( audio_output_t *p_aout, audio_sample_format_t *fmt )
     if (p_sys->player->InitCheck() != B_OK) {
         msg_Err( p_aout, "cannot initialize BSoundPlayer");
 		delete p_sys->player;
-        free(p_sys);
+        p_sys->player = NULL;
         return VLC_EGENERIC;
     }
 
@@ -138,7 +140,7 @@ static int Start ( audio_output_t *p_aout, audio_sample_format_t *fmt )
 
     CreateBuffer( p_aout, AUDIO_BUFFER_SIZE_IN_SECONDS * format.i_rate * format.i_bytes_per_frame );
     
-    VolumeSet(p_aout, 1.0 );
+    ApplyVolume(p_sys);
                       
 	p_sys->player->Start();
 
@@ -188,6 +190,13 @@ static int Open (vlc_object_t *obj)
     if( unlikely( sys == NULL ))
         return VLC_ENOMEM;
 
+    /* The media kit needs a running BApplication */
+    if( vlc_haiku_app_Hold( aout ) )
+    {
+        free( sys );
+        return VLC_EGENERIC;
+    }
+
     aout->sys = sys;
     aout->start = Start;
     aout->stop = Stop;
@@ -195,6 +204,10 @@ static int Open (vlc_object_t *obj)
     aout->volume_set = VolumeSet;
 
     sys->player = NULL;
+    sys->volume = 1.f;
+    sys->mute = false;
+    aout_VolumeReport(aout, sys->volume);
+    aout_MuteReport(aout, sys->mute);
 
     return VLC_SUCCESS;
 }
@@ -205,6 +218,7 @@ static void Close( vlc_object_t *obj )
     aout_sys_t *sys = aout->sys;
 
     free(sys);
+    vlc_haiku_app_Release();
 }
 
 static void Pause( audio_output_t *aout, bool pause, mtime_t date )
@@ -255,21 +269,27 @@ static int TimeGet( audio_output_t *aout, mtime_t *restrict delay )
     return 0;
 }
 
+/* Applies the stored volume and mute state to the player, if any */
+static void ApplyVolume(aout_sys_t* sys)
+{
+    if (sys->player == NULL)
+        return;
+
+    if (sys->mute || sys->volume <= 0.f)
+        sys->player->SetVolume(0.0);
+    else
+        sys->player->SetVolumeDB(lroundf(125.f * log10f(sys->volume)));
+}
+
+/* Volume and mute are kept across streams: the core sets them while no
+ * stream is playing too */
