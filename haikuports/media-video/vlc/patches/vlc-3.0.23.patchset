+        view->AddChild(glview);
+#endif
         view->MakeFocus(true);
         SetSizeLimits(32, 30000, 32, 30000);
     }
 
     VideoView *View() const { return view; }
+#ifdef HAIKU_VOUT_GL
+    BGLView *GLView() const { return glview; }
+#endif
 
     virtual void MessageReceived(BMessage *msg)
     {
@@ -433,6 +503,9 @@ public:
 private:
     vout_display_t *vd;
     VideoView *view;
+#ifdef HAIKU_VOUT_GL
+    BGLView *glview;
+#endif
     BRect saved_frame;
     bool is_fullscreen;
