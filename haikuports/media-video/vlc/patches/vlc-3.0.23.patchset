From 7907a7cfca00723d905ef52139609d6510d9bc80 Mon Sep 17 00:00:00 2001
From: idumych <idumych@gmail.com>
Date: Sat, 24 Oct 2026 17:29:05 -0700
Subject: [PATCH 05/11] vlc: no global hotkeys interface with the Haiku API

There is no global hotkeys module on Haiku, VitruvianOS or the Cosmoe
builds (it needs X11), so asking for it only printed an error at
every start.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 bin/vlc.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/bin/vlc.c b/bin/vlc.c
index 72e0eee..259afa0 100644
--- a/bin/vlc.c
+++ b/bin/vlc.c
@@ -238,7 +238,8 @@ int main( int i_argc, const char *ppsz_argv[] )
     libvlc_set_user_agent (vlc, "VLC media player", "VLC/"PACKAGE_VERSION);
 
     libvlc_add_intf (vlc, "hotkeys,none");
-#if !defined (__OS2__)
+/* No global hotkeys module for OS/2 or the Haiku API (it needs X11) */
+#if !defined (__OS2__) && !defined (VLC_HAIKU_API)
     libvlc_add_intf (vlc, "globalhotkeys,none");
 #endif
     if (libvlc_add_intf (vlc, NULL))
-- 
2.56.0


From 2fb686199bff0a46dc70f89aa890a51961d52d22 Mon Sep 17 00:00:00 2001
From: idumych <idumych@gmail.com>
Date: Sat, 24 Oct 2026 18:18:58 -0700
Subject: [PATCH 06/11] Haiku API: keep the plugins loaded and wait for windows
 to go away

On VitruvianOS, BWindow::Quit() called from another thread (and
wait_for_thread()) can return while the window's thread still runs the
destructor, and VLC then unloaded the plugin under it: VLC crashed on
quit about one time in six. The interface and video output plugins now
use cannot_unload_broken_library(), and their Close() functions wait
until the window's port is gone. 32 starts and quits on VitruvianOS
0.6.2 without a crash (before: 1 in 6).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 modules/gui/haiku/MessagesWindow.cpp    | 6 ++++++
 modules/gui/haiku/PlayListWindow.cpp    | 6 ++++++
 modules/gui/haiku/PreferencesWindow.cpp | 9 ++++++++-
 modules/gui/haiku/haiku.cpp             | 8 ++++++++
 modules/video_output/haiku.cpp          | 9 +++++++++
 5 files changed, 37 insertions(+), 1 deletion(-)

diff --git a/modules/gui/haiku/MessagesWindow.cpp b/modules/gui/haiku/MessagesWindow.cpp
index f7ebccb..9dbd1d9 100644
--- a/modules/gui/haiku/MessagesWindow.cpp
+++ b/modules/gui/haiku/MessagesWindow.cpp
@@ -211,7 +211,13 @@ void MessagesWindow::ReallyQuit()
     if( fSubscribed )
         vlc_LogSet( p_intf->obj.libvlc, NULL, NULL );
 
+    /* Wait until the window is gone: on VitruvianOS, Quit() from another
+     * thread (and wait_for_thread()) can return before it is */
+    BMessenger messenger( this );
     Lock();
     Hide();
     Quit();
+    /* The looper's port goes away at the end of its destructor */
+    for( int i = 0; i < 200 && messenger.IsValid(); i++ )
+        snooze( 10000 );
 }
diff --git a/modules/gui/haiku/PlayListWindow.cpp b/modules/gui/haiku/PlayListWindow.cpp
index b0b353b..94f6b39 100644
--- a/modules/gui/haiku/PlayListWindow.cpp
+++ b/modules/gui/haiku/PlayListWindow.cpp
@@ -212,9 +212,15 @@ PlayListWindow::MessageReceived( BMessage * p_message )
 void
 PlayListWindow::ReallyQuit()
 {
+    /* Wait until the window is gone: on VitruvianOS, Quit() from another
+     * thread (and wait_for_thread()) can return before it is */
+    BMessenger messenger( this );
     Lock();
     Hide();
     Quit();
+    /* The looper's port goes away at the end of its destructor */
+    for( int i = 0; i < 200 && messenger.IsValid(); i++ )
+        snooze( 10000 );
 }
 
 /*****************************************************************************
diff --git a/modules/gui/haiku/PreferencesWindow.cpp b/modules/gui/haiku/PreferencesWindow.cpp
index ccda4c4..26296f7 100644
--- a/modules/gui/haiku/PreferencesWindow.cpp
+++ b/modules/gui/haiku/PreferencesWindow.cpp
@@ -366,11 +366,18 @@ void PreferencesWindow::Apply( bool doIt )
 /*****************************************************************************
  * PreferencesWindow::ReallyQuit
  *****************************************************************************/
-void PreferencesWindow::ReallyQuit()
+void
+PreferencesWindow::ReallyQuit()
 {
+    /* Wait until the window is gone: on VitruvianOS, Quit() from another
+     * thread (and wait_for_thread()) can return before it is */
+    BMessenger messenger( this );
     Lock();
     Hide();
     Quit();
+    /* The looper's port goes away at the end of its destructor */
+    for( int i = 0; i < 200 && messenger.IsValid(); i++ )
+        snooze( 10000 );
 }
 
 /***********************************************************************
