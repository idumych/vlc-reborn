From 5c9900e6d832fcffb05331df4fafb10b1ee873c8 Mon Sep 17 00:00:00 2001
From: idumych <idumych@gmail.com>
Date: Sat, 24 Oct 2026 18:32:51 -0700
Subject: [PATCH 07/11] avcodec: no hardware formats without a hardware decoder
 module

Builds without VA-API and VDPAU (the Haiku API ones) have no "hw decoder"
module, so trying each hardware format only failed to set up the video
output, logging errors, before falling back to software decoding.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 modules/codec/avcodec/video.c | 18 +++++++++++++++++-
 1 file changed, 17 insertions(+), 1 deletion(-)

diff --git a/modules/codec/avcodec/video.c b/modules/codec/avcodec/video.c
index 3412a7f..1b75dc0 100644
--- a/modules/codec/avcodec/video.c
+++ b/modules/codec/avcodec/video.c
@@ -34,6 +34,7 @@
 #include <vlc_avcodec.h>
 #include <vlc_cpu.h>
 #include <vlc_atomic.h>
+#include <vlc_modules.h>
 #include <assert.h>
 
 #include <libavcodec/avcodec.h>
@@ -682,6 +683,21 @@ static int ffmpeg_OpenVa(decoder_t *p_dec, AVCodecContext *p_context,
     return VLC_SUCCESS;
 }
 
+/* Without a hardware decoder module (builds with neither VA-API nor VDPAU,
+ * such as the Haiku API ones), each hardware format would only fail to set up
+ * the video output before falling back to software decoding */
+static bool HasHwDecoderModule(void)
+{
+    size_t count;
+    module_t **list = module_list_get(&count);
+    bool found = false;
+
+    for (size_t i = 0; i < count && !found; i++)
+        found = module_provides(list[i], "hw decoder");
+    module_list_free(list);
+    return found;
+}
+
 static const enum PixelFormat hwfmts[] =
 {
 #ifdef _WIN32
@@ -1830,7 +1846,7 @@ no_reuse:
     p_sys->profile = p_context->profile;
     p_sys->level = p_context->level;
 
-    if (!can_hwaccel)
+    if (!can_hwaccel || !HasHwDecoderModule())
         return swfmt;
 
 #if (LIBAVCODEC_VERSION_MICRO >= 100) && !(LIBAVCODEC_VERSION_CHECK(57, 83, 101))
-- 
2.56.0


From 4104d0db1c88c01ef61694ee7c434df895ea6415 Mon Sep 17 00:00:00 2001
From: idumych <idumych@gmail.com>
Date: Sat, 24 Oct 2026 19:07:16 -0700
Subject: [PATCH 08/11] avcodec: libavcodec's own buffer when the video output
 has no picture

When the decoder is killed while frame threads still decode, the video
output is stopping and has no pictures: get_buffer() failed and FFmpeg
logged slice errors on every quit (about one in six on VitruvianOS).
DecodeBlock() already copies frames libavcodec allocated, or drops them.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 modules/codec/avcodec/video.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/modules/codec/avcodec/video.c b/modules/codec/avcodec/video.c
index 1b75dc0..4319c1f 100644
--- a/modules/codec/avcodec/video.c
+++ b/modules/codec/avcodec/video.c
@@ -1733,7 +1733,15 @@ static int lavc_GetFrame(struct AVCodecContext *ctx, AVFrame *frame, int flags)
 
     pic = decoder_NewPicture(dec);
     if (pic == NULL)
+    {
+        /* No picture from the video output (it is stopping, as when the
+         * decoder is killed while frame threads still decode, or it ran
+         * out): let libavcodec allocate the frame instead of failing the
+         * slice. DecodeBlock() copies it to a picture, or drops it. */
+        if (sys->p_va == NULL)
+            return avcodec_default_get_buffer2(ctx, frame, flags);
         return -ENOMEM;
+    }
 
     if (sys->p_va != NULL)
         return lavc_va_GetFrame(ctx, frame, pic);
-- 
2.56.0


From 88bf55cdfe01656f4a18b8a898b082880992589e Mon Sep 17 00:00:00 2001
From: idumych <idumych@gmail.com>
Date: Sat, 24 Oct 2026 20:54:38 -0700
Subject: [PATCH 09/11] Haiku API: OpenGL video output in a BGLView

The OpenGL output needs a window provider, which Haiku API builds don't
have, so choosing it played sound only. haiku_gl is the BBitmap output's
code built a second time (HAIKU_VOUT_GL): the same window, keys, mouse and
fullscreen, with a BGLView that VLC's OpenGL renderer draws into. BBitmap
stays the default. The library with BGLView is HAIKU_GL_LIBS (Haiku: -lGL;
VitruvianOS: -lopengl; Hokku: -lopengl). Core GL functions come from the GL
library when BGLView::GetGLProcAddress() doesn't know them (VitruvianOS).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 configure.ac                     |   6 +
 modules/video_output/Makefile.am |  11 ++
 modules/video_output/haiku.cpp   | 233 ++++++++++++++++++++++++++++++-
 3 files changed, 247 insertions(+), 3 deletions(-)

diff --git a/configure.ac b/configure.ac
index 8124cc3..948650a 100644
--- a/configure.ac
+++ b/configure.ac
@@ -3201,6 +3201,12 @@ PKG_CHECK_MODULES([GL], [gl], [
   AC_MSG_RESULT([${have_gl}])
 ])
 AM_CONDITIONAL([HAVE_GL], [test "${have_gl}" = "yes"])
+
+dnl OpenGL output in a BGLView (Haiku API): libGL on Haiku; elsewhere the
+dnl library with BGLView must be named (VitruvianOS: -lopengl)
+AC_ARG_VAR([HAIKU_GL_LIBS], [linker flags for BGLView (default: -lGL on Haiku)])
+AS_IF([test "${SYS}" = "haiku" && test -z "${HAIKU_GL_LIBS}"], [HAIKU_GL_LIBS="-lGL"])
+AM_CONDITIONAL([HAVE_HAIKU_GL], [test "${enable_haiku_api}" = "yes" && test "${have_gl}" = "yes" && test -n "${HAIKU_GL_LIBS}"])
 AS_IF([test "${have_gl}" = "yes"], [
   AC_DEFINE([HAVE_GL], 1, [Defined if having OpenGL])
 ])
diff --git a/modules/video_output/Makefile.am b/modules/video_output/Makefile.am
index 39a66fe..46b83ae 100644
--- a/modules/video_output/Makefile.am
+++ b/modules/video_output/Makefile.am
@@ -387,6 +387,17 @@ if HAVE_HAIKU_API
 vout_LTLIBRARIES += libhaiku_vout_plugin.la
 endif
 
+libhaiku_gl_plugin_la_SOURCES = video_output/haiku.cpp $(OPENGL_COMMONSOURCES)
+libhaiku_gl_plugin_la_CPPFLAGS = $(AM_CPPFLAGS) -DHAIKU_VOUT_GL
+libhaiku_gl_plugin_la_CFLAGS = $(AM_CFLAGS) $(GL_CFLAGS) $(OPENGL_COMMONCLFAGS)
+libhaiku_gl_plugin_la_CXXFLAGS = $(AM_CXXFLAGS) $(HAIKU_API_CFLAGS) $(GL_CFLAGS) \
+	$(OPENGL_COMMONCLFAGS)
+libhaiku_gl_plugin_la_LIBADD = $(HAIKU_API_LIBS) $(HAIKU_GL_LIBS) $(LIBDL) $(LIBM) \
+	$(OPENGL_COMMONLIBS)
+if HAVE_HAIKU_GL
+vout_LTLIBRARIES += libhaiku_gl_plugin.la
+endif
+
 ### OS/2 ###
 if HAVE_OS2
 vout_LTLIBRARIES += libdrawable_plugin.la
diff --git a/modules/video_output/haiku.cpp b/modules/video_output/haiku.cpp
index e3bc740..6f115f9 100644
--- a/modules/video_output/haiku.cpp
+++ b/modules/video_output/haiku.cpp
@@ -45,7 +45,18 @@
 #include <View.h>
 #include <Window.h>
 
-#define VOUT_HAIKU_TITLE "VideoLAN Client " VERSION " (BBitmap output)"
+/* Built twice: the BBitmap output, and with HAIKU_VOUT_GL the OpenGL output,
+ * which draws with VLC's OpenGL renderer into a BGLView in the same window */
+#ifdef HAIKU_VOUT_GL
+# include <dlfcn.h>
+# include <GLView.h>
+extern "C" {
+# include "opengl/vout_helper.h"
+}
+# define VOUT_HAIKU_TITLE "VideoLAN Client " VERSION " (OpenGL output)"
+#else
+# define VOUT_HAIKU_TITLE "VideoLAN Client " VERSION " (BBitmap output)"
+#endif
 
 static int  Open(vlc_object_t *);
 static void Close(vlc_object_t *);
@@ -55,15 +66,24 @@ static void Close(vlc_object_t *);
     "window size. Turn this off on slow machines.")
 
 vlc_module_begin ()
-    set_shortname("BBitmap")
     set_category(CAT_VIDEO)
     set_subcategory(SUBCAT_VIDEO_VOUT)
+#ifdef HAIKU_VOUT_GL
+    set_shortname("BGLView")
+    set_description(N_("Haiku OpenGL video output"))
+    /* Below BBitmap, which stays the default */
+    set_capability("vout display", 265)
+    add_shortcut("haiku_gl", "bglview")
+    add_glopts()
+#else
+    set_shortname("BBitmap")
