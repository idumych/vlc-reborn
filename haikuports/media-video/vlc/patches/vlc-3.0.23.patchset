+
+    vd->info.has_double_click = true;
+    vd->info.needs_hide_mouse = true;
+    vd->pool    = Pool;
+    vd->prepare = NULL;
+    vd->display = Display;
+    vd->control = Control;
+    vd->manage  = NULL;
