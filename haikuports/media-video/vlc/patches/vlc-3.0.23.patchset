     fMenuBar->AddItem( showMenu );
 
     // add the media control view after the menubar is complete
@@ -766,6 +762,17 @@ void InterfaceWindow::MessageReceived( BMessage * p_message )
             UpdateInterface();
             break;
 
+        case SWITCH_INTERFACE:
+        {
