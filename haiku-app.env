# haiku-app.env — what the beos-app-platforms release tools need to know about VLC Reborn.
# Shell syntax: sourced by packaging/*.sh, the CI workflows and the release scripts.

# ── Identity ──
APP_NAME="VLC"
APP_CMD="vlc"
APP_SIG="application/x-vnd.vlc"
RDEF="packaging/VLC.rdef"   # the recipe's vlc.rdef.in with the values filled in
APP_PATH="apps/VLC media player"   # the launcher; the vlc command is bin/VLC
DESKBAR_NAME="VLC media player"

# ── Version (also in the recipe's REVISION) ──
VERSION="3.0.23"
REVISION="6"

# ── Package metadata ──
SUMMARY="VLC media player with its native BeOS-style interface"
DESCRIPTION_FILE="packaging/description.txt"
HOMEPAGE="https://github.com/idumych/vlc-reborn"
GITHUB_REPO="idumych/vlc-reborn"
LICENSE_NAME="GNU GPL v2"
COPYRIGHT="1996-2026 VideoLAN and VLC authors"
PACKAGER="idumych <idumych@gmail.com>"

HPKG_REQUIRES_EXTRA=""
DESKTOP_CATEGORIES="AudioVideo;Player;Video;Audio;"
APPIMAGE_MUST_BUNDLE="libvlc libvlccore libavcodec"
APPIMAGE_FONTS_EXTRA=""
COSMOE_REPO=""
COSMOE_TAG=""
APPIMAGE_APT_EXTRA=""

# ── Build ──
HPKG_BUILD_DEPS=""
TEST_CMD=""
TYPECHECK_SRCS=""
TYPECHECK_INCLUDES=""

# ── Feature test ──
FEATURE_CHECKS="playback"
EVIDENCE_1="{p}-screen.txt|VideoLAN Client"
